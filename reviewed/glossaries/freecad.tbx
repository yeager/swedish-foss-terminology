<termEntry id="re6eacfa175181885186469b0"><langSet xml:lang="en"><tig><term>Tank Capacity Curve</term></tig></langSet><langSet xml:lang="sv"><tig><term>Tankens kapacitetskurva</term></tig></langSet><note>{"id":"e6eacfa175181885186469b0","source":"Tank Capacity Curve","canonical":"Tankens kapacitetskurva","project":"FreeCAD","component":"freecad.tbx.xliff","context":"This is a plot of true vertical height versus volume. Simple, symmetrically shaped tanks (square, rectangular and cylindrical) have linear capacity curves that are relatively easy to calculate. Hopper tanks and tanks with irregular shapes and/or intrusions (such as piping running through them) require specific plots of height versus volume, usually supplied by the tank manufacturer, or determined empirically after construction.\nhttp://levelcom.net/about/faqs/","note":"","scope":"project-context","review_id":"f7f3f6ca59d9a555fe1ecb9e","publication_status":"reviewed-local","reference":"https://crowdin.com/translate/freecad/32154/en-sv-SE","evidence_sha256":"bb6624fb1f53ee85440a32c45cef351ecffacbc7a98d352f980939c65794de81","source_evidence":"{}"}</note></termEntry>
