<termEntry id="r1a1d516536d377702c0d1339"><langSet xml:lang="en"><tig><term>voronoi diagram</term></tig></langSet><langSet xml:lang="sv"><tig><term>Voronoidiagram</term></tig></langSet><note>{"id":"1a1d516536d377702c0d1339","source":"voronoi diagram","canonical":"Voronoidiagram","project":"FreeCAD","component":"freecad.tbx.xliff","context":"The partitioning of a plane with n points into convex polygons such that each polygon contains exactly one generating point and every point in a given polygon is closer to its generating point than to any other. A Voronoi diagram is sometimes also known as a Dirichlet tessellation. The cells are called Dirichlet regions, Thiessen polytopes, or Voronoi polygons.","note":"Språklig rättelse efter kontroll mot källtexten.","scope":"project-context","review_id":"050cd74166cd044675e140eb","publication_status":"reviewed-local","reference":"https://crowdin.com/translate/freecad/32154/en-sv-SE","evidence_sha256":"bb6624fb1f53ee85440a32c45cef351ecffacbc7a98d352f980939c65794de81","source_evidence":"{}"}</note></termEntry>
