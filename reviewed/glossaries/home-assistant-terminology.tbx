<termEntry id="rha-onewire-sensed-channel-20261126"><langSet xml:lang="en"><tig><term>Sensed</term></tig></langSet><langSet xml:lang="sv"><tig><term>Ingångskanal</term></tig></langSet><note>{"id":"ha-onewire-sensed-channel-20261126","source":"Sensed","canonical":"Ingångskanal","project":"Home Assistant","component":"1-Wire binary sensor","context":"Label for the state of a digital input channel","note":"Översätt Sensed med Ingångskanal i detta sammanhang; Home Assistant beskriver entiteten som tillståndet för en ingångskanal.","scope":"project-context","review_id":"ha-onewire-sensed-channel-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_integration_documentation\":\"https://www.home-assistant.io/integrations/onewire\",\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/onewire/binary_sensor.py\",\"translation_keys\":[\"sensed\",\"sensed_id\"],\"documented_semantics\":\"state of an input channel\"}","reference":"https://www.home-assistant.io/integrations/onewire","evidence_sha256":"43b03115db92e4d1cfffb79268b8f02c01b76bc7139740d93ae5731f28b98e7f"}</note></termEntry>
