<martif type="TBX" xml:lang="en"><martifHeader><fileDesc><titleStmt><title>Swedish project-specific review terms</title></titleStmt><sourceDesc><p>Generated from reviewed/data JSONL; recommendations require matching project context.</p></sourceDesc></fileDesc></martifHeader><text><body>
<termEntry id="r1195609059708b0351a9dd57"><langSet xml:lang="en"><tig><term>USB dongle</term></tig></langSet><langSet xml:lang="sv"><tig><term>USB-dongel</term></tig></langSet><note>{"id":"1195609059708b0351a9dd57","source":"USB dongle","canonical":"USB-dongel","project":"Home Assistant","component":"user-approved terminology","context":"Hardware; USB-connected radio adapter","note":"Användargodkänd term (2026-11-25). Använd USB-dongel i svensk Home Assistant-text.","scope":"project-context","review_id":"07f8d1080e3058c967341afd","publication_status":"user-approved-local-preference","reference":"Codex user instruction, 2026-11-25: “usb-dongel är ok. lägg in i verktygen”","evidence_sha256":"07f8d1080e3058c967341afdd5ad69013026c850f8c8f9ab4a1d348c1bb8cf5b","source_evidence":"{}"}</note></termEntry>
<termEntry id="ropenevse-power-shaper-20261125"><langSet xml:lang="en"><tig><term>Current shaper</term></tig></langSet><langSet xml:lang="sv"><tig><term>Laststyrning</term></tig></langSet><note>{"id":"openevse-power-shaper-20261125","source":"Current shaper","canonical":"Laststyrning","project":"Home Assistant","component":"OpenEVSE","context":"Switch controlling the OpenEVSE Power Shaper function; related sensors report available current and power under household load.","note":"Översätt funktionen som laststyrning. OpenEVSE beskriver Power Shaper som en funktion som begränsar laddaren utifrån husets belastning. Ersätter den missvisande äldre HA-termen Strömformare.","scope":"project-context","review_id":"openevse-shaper-review-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_commit\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"home_assistant_core_path\":\"homeassistant/components/openevse/switch.py\",\"open_evse_document_excerpt\":\"Where the shaper caps one charger against the whole house, load sharing splits one supply between several OpenEVSE units.\"}","reference":"https://github.com/OpenEVSE/openevse_esp32_firmware/blob/master/docs/user/load-shaper.md","evidence_sha256":"a46b2b440879cf04a6780681de88856aabd890ef54666a35590cd5c616392072"}</note></termEntry>
<termEntry id="rvicare-inverter-20261125"><langSet xml:lang="en"><tig><term>Inverter</term></tig></langSet><langSet xml:lang="sv"><tig><term>växelriktare</term></tig></langSet><note>{"id":"vicare-inverter-20261125","source":"Inverter","canonical":"växelriktare","project":"Home Assistant","component":"ViCare","context":"Electrical inverter in ViCare energy/solar sensor names; not the verb “invert”.","note":"Använd växelriktare för ViCare-sensorer som mäter inverterns ström, effekt och temperatur. Svensk Viessmann-terminologi använder växelriktare för enheten som omvandlar likström från solceller till växelström.","scope":"project-context","review_id":"home-assistant-vicare-inverter-review-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_commit\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"home_assistant_core_path\":\"homeassistant/components/vicare/strings.json\",\"home_assistant_core_source\":[\"Inverter current\",\"Inverter power\",\"Inverter temperature\"],\"viessmann_swedish_excerpt\":\"Energiomvandling: Den likström som genereras av solgeneratorn omvandlas sedan av växelriktaren (vanligen även kallad solinverter eller nätinmatningsenhet) till växelström som är lämplig för nätet.\"}","reference":"https://www.viessmann.se/sv/information/teknik-och-system/solceller.html","evidence_sha256":"ee129b973439ff46719475c38615a8e7193c1dd4cd019e75bf680cbe7074fd3c"}</note></termEntry>
<termEntry id="rtibber-load-household-20261125"><langSet xml:lang="en"><tig><term>Load</term></tig></langSet><langSet xml:lang="sv"><tig><term>hushåll</term></tig></langSet><note>{"id":"tibber-load-household-20261125","source":"Load","canonical":"hushåll","project":"Home Assistant","component":"Tibber energy-flow sensors","context":"The `load` node in Tibber’s powerFlow/energyFlow graph; not generic electrical load and not the verb “load”.","note":"Översätt den här noden som hushåll/hushållet. Home Assistant-källan visar flöden både till och från noden: nät och batteri kan försörja den, och noden kan i sin tur leverera energi till batteri eller elnät. Detta är en kontextuell tolkning av HA:s datamodell; kontrollera mot Tibbers formella schema om en definition publiceras.","scope":"project-context","review_id":"home-assistant-tibber-load-node-20261125","publication_status":"reviewed-local-amendment-with-semantic-follow-up","source_evidence":"{\"home_assistant_core_commit\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"source_paths\":[\"homeassistant/components/tibber/sensor.py\",\"homeassistant/components/tibber/strings.json\",\"tests/components/tibber/test_sensor.py\"],\"flow_node_evidence\":[\"powerFlow.load.power is the power value for the load node\",\"powerFlow.toLoad and powerFlow.fromLoad are directional edges to/from the load node\",\"energyFlow.*.load.source.{grid,battery} supplies the load node\",\"energyFlow.*.{grid,battery}.source.load moves energy from the load node to grid/battery\"],\"interpretation\":\"The source code establishes a bidirectional household-side energy-flow node; translating the user-facing node as household is a contextual inference. Confirm against a formal Tibber schema if one becomes available.\",\"source_sha256\":{\"homeassistant/components/tibber/sensor.py\":\"45f58732eb5104b04eee13cc5272e89f98782e6d40e6472a71ec92749f8a9073\",\"homeassistant/components/tibber/strings.json\":\"0c20571707319b4720ab508d9673f5bc4c5faff94b1bcf56b1f99a90732ed300\",\"tests/components/tibber/test_sensor.py\":\"17fd3be7834ed0909531b467c7e5950a5a6d256d2c1ac478ad5167355eaaa7b6\"}}","reference":"https://github.com/home-assistant/core/blob/86a2eabe7e43f526db5821ef068087ce8404ae07/homeassistant/components/tibber/sensor.py","evidence_sha256":"5057ac8f6e7a575e09bf686bb76388dc4320edcc7e20487a7c14c02d257e8569"}</note></termEntry>
<termEntry id="rha-matter-occupied-setback-20261125"><langSet xml:lang="en"><tig><term>Occupied setback</term></tig></langSet><langSet xml:lang="sv"><tig><term>Tillåten temperaturavvikelse vid närvaro</term></tig></langSet><note>{"id":"ha-matter-occupied-setback-20261125","source":"Occupied setback","canonical":"Tillåten temperaturavvikelse vid närvaro","project":"Home Assistant","component":"Matter thermostat","context":"Numeric thermostat attribute measured in degrees Celsius. It represents the tolerance from the setpoint, not a downward temperature adjustment.","note":"Använd denna funktionsbeskrivning; översätt inte setback som temperatursänkning i denna Matter-kontekst. Matter-specifikationen beskriver den tillåtna avvikelsen från termostatens börvärde.","scope":"project-context","review_id":"ha-matter-occupied-setback-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"source_revision\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"core_path\":\"homeassistant/components/matter/number.py\",\"matter_specification\":\"Matter Application Cluster Specification R1.1, OccupiedSetback attribute\",\"source_url\":\"https://csa-iot.org/wp-content/uploads/2023/05/matter-1-1-application-cluster-specification.pdf\"}","reference":"https://github.com/yeager/translations/blob/main/Home-Assistant/Lokalise/2026-11-25-tool-terminology-context.md","evidence_sha256":"de3186355081aee1ad26120c855bf1de1be6318da8441f41cd38267f9d0682fb"}</note></termEntry>
<termEntry id="rha-yardian-water-hammer-20261125"><langSet xml:lang="en"><tig><term>Water hammer</term></tig></langSet><langSet xml:lang="sv"><tig><term>tryckslag</term></tig></langSet><note>{"id":"ha-yardian-water-hammer-20261125","source":"Water hammer","canonical":"tryckslag","project":"Home Assistant","component":"Yardian irrigation","context":"Hydraulic pressure wave in irrigation pipes when a valve closes; the Yardian feature reduces it by overlapping watering zones.","note":"Använd tryckslag för fenomenet. I Yardians sensorbenämning används Överlappningstid för att minska tryckslag.","scope":"project-context","review_id":"ha-yardian-water-hammer-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"source_revision\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"core_path\":\"homeassistant/components/yardian/sensor.py\",\"manufacturer_documentation\":\"https://www.yardian.com/blogs/guides/water-hammer-reduction/\",\"feature\":\"The configured duration is overlap between zones to reduce water hammer.\"}","reference":"https://github.com/yeager/translations/blob/main/Home-Assistant/Lokalise/2026-11-25-tool-terminology-context.md","evidence_sha256":"de3186355081aee1ad26120c855bf1de1be6318da8441f41cd38267f9d0682fb"}</note></termEntry>
<termEntry id="rha-hdfury-issue-hotplug-20261125"><langSet xml:lang="en"><tig><term>Issue hotplug</term></tig></langSet><langSet xml:lang="sv"><tig><term>Skicka hotplug-signal</term></tig></langSet><note>{"id":"ha-hdfury-issue-hotplug-20261125","source":"Issue hotplug","canonical":"Skicka hotplug-signal","project":"Home Assistant","component":"HDFury button","context":"Button sends a hotplug command to attached TX and RX devices.","note":"Använd Skicka hotplug-signal som knappnamn; hotplug behålls som teknisk protokollterm.","scope":"project-context","review_id":"ha-hdfury-issue-hotplug-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"source_revision\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"core_path\":\"homeassistant/components/hdfury/button.py\",\"manufacturer_documentation\":\"https://www.home-assistant.io/integrations/hdfury/\",\"documented_function\":\"Issue hotplug sends a command to hotplug connected TX and RX devices.\"}","reference":"https://github.com/yeager/translations/blob/main/Home-Assistant/Lokalise/2026-11-25-tool-terminology-context.md","evidence_sha256":"de3186355081aee1ad26120c855bf1de1be6318da8441f41cd38267f9d0682fb"}</note></termEntry>
<termEntry id="rha-knx-datapoint-type-20261125"><langSet xml:lang="en"><tig><term>KNX datapoint type</term></tig></langSet><langSet xml:lang="sv"><tig><term>datapunkttyp</term></tig></langSet><note>{"id":"ha-knx-datapoint-type-20261125","source":"KNX datapoint type","canonical":"datapunkttyp","project":"Home Assistant","component":"KNX project import","context":"KNX group address configuration; plural datapunkttyper.","note":"Använd den officiella svenska KNX-termen datapunkttyp (plural datapunkttyper).","scope":"project-context","review_id":"ha-knx-dpt-20261125","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"86a2eabe7e43f526db5821ef068087ce8404ae07\",\"home_assistant_core_path\":\"homeassistant/components/knx/strings.json\",\"home_assistant_source_phrases\":[\"datapoint types\",\"datapoint types\"],\"official_knx_swedish_source\":\"https://support.knx.org/hc/sv/articles/115001366044-Gruppadresser-och-datapunkttyper\",\"official_knx_term\":\"datapunkttyper\"}","reference":"https://support.knx.org/hc/sv/articles/115001366044-Gruppadresser-och-datapunkttyper","evidence_sha256":"40ddb4fe7c7a76e747bb1f9cf39ef721ccd1231c4547f70049120621561523a8"}</note></termEntry>
<termEntry id="rha-husqvarna-geofence-name-20261126"><langSet xml:lang="en"><tig><term>GeoFence</term></tig></langSet><langSet xml:lang="sv"><tig><term>GeoFence</term></tig></langSet><note>{"id":"ha-husqvarna-geofence-name-20261126","source":"GeoFence","canonical":"GeoFence","project":"Home Assistant","component":"Husqvarna Automower","context":"Husqvarna Automower; branded GPS theft-protection feature name","note":"Behåll produktfunktionsnamnet GeoFence enligt Husqvarnas svenskspråkiga dokumentation; där beskrivs det som ett GPS-baserat stöldskyddssystem och ett virtuellt staket.","scope":"project-context","review_id":"ha-husqvarna-geofence-name-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"manufacturer_documentation\":\"https://www.husqvarna.com/se/support/husqvarna-self-service/sa-har-aktiverar-du-geo-fence-och-gps-sparning-pa-automower-robotgrasklipparen-ka-01568/\",\"manufacturer_excerpt\":\"GeoFence-larm är ett GPS-baserat stöldskyddssystem som fungerar som ett virtuellt staket för Automower®-robotgräsklipparen.\",\"interpretation\":\"The documentation names GeoFence as a theft-protection feature and explains it as a virtual fence.\"}","reference":"https://www.husqvarna.com/se/support/husqvarna-self-service/sa-har-aktiverar-du-geo-fence-och-gps-sparning-pa-automower-robotgrasklipparen-ka-01568/","evidence_sha256":"10dc31a64857681ba77e9acd68a1421deb25c85b8de0d43b4cd6b19b7dc50ca4"}</note></termEntry>
<termEntry id="rha-husqvarna-outside-geofence-alarm-20261126"><langSet xml:lang="en"><tig><term>Outside geofence</term></tig></langSet><langSet xml:lang="sv"><tig><term>Utanför stöldskyddsområdet</term></tig></langSet><note>{"id":"ha-husqvarna-outside-geofence-alarm-20261126","source":"Outside geofence","canonical":"Utanför stöldskyddsområdet","project":"Home Assistant","component":"Husqvarna Automower","context":"Home Assistant Husqvarna Automower alarm/event label","note":"Översätt områdesreferensen med Husqvarnas svenska felmeddelandeterminologi för funktionen. Undvik den missvisande ordagranna termen geostaket i denna produktkontext.","scope":"project-context","review_id":"ha-husqvarna-outside-geofence-alarm-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"manufacturer_documentation\":\"https://www.husqvarna.com/se/support/husqvarna-self-service/sa-har-aktiverar-du-geo-fence-och-gps-sparning-pa-automower-robotgrasklipparen-ka-01568/\",\"manufacturer_excerpt\":\"GeoFence-larm är ett GPS-baserat stöldskyddssystem som fungerar som ett virtuellt staket för Automower®-robotgräsklipparen.\",\"interpretation\":\"The documentation names GeoFence as a theft-protection feature and explains it as a virtual fence.\"}","reference":"https://www.husqvarna.com/se/support/husqvarna-self-service/sa-har-aktiverar-du-geo-fence-och-gps-sparning-pa-automower-robotgrasklipparen-ka-01568/","evidence_sha256":"10dc31a64857681ba77e9acd68a1421deb25c85b8de0d43b4cd6b19b7dc50ca4"}</note></termEntry>
<termEntry id="rha-tesla-vehicle-preconditioning-20261126"><langSet xml:lang="en"><tig><term>vehicle preconditioning</term></tig></langSet><langSet xml:lang="sv"><tig><term>förkonditionering</term></tig></langSet><note>{"id":"ha-tesla-vehicle-preconditioning-20261126","source":"vehicle preconditioning","canonical":"förkonditionering","project":"Home Assistant","component":"Teslemetry vehicle schedules","context":"Tesla vehicle charging and preconditioning schedule; warming the cabin and battery before departure","note":"Använd förkonditionering för Teslas funktion som värmer upp bilens batteri och kupé före avfärd. Skriv schema för förkonditionering när källan avser en scheduled preconditioning action.","scope":"project-context","review_id":"ha-tesla-vehicle-preconditioning-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"manufacturer_documentation\":\"https://www.tesla.com/sv_se/support/winter-driving-tips\",\"manufacturer_excerpt\":\"Förkonditionering värmer upp bilens batteri och kupé innan du ska åka, så att du får en behaglig körupplevelse. Du kan schemalägga förkonditionering av din bil via bilens touchskärm eller via Tesla-appen.\",\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"home_assistant_core_path\":\"homeassistant/components/teslemetry/strings.json\",\"source_phrases\":[\"preconditioning\",\"preconditioning schedule\"]}","reference":"https://www.tesla.com/sv_se/support/winter-driving-tips","evidence_sha256":"0ab22661e6b0ca65fcfeaf5c05323c1d7dfb54cb0b53f05923bde855846e87f5"}</note></termEntry>
<termEntry id="rha-matter-effective-current-20261126"><langSet xml:lang="en"><tig><term>Effective current</term></tig></langSet><langSet xml:lang="sv"><tig><term>Strömmens effektivvärde</term></tig></langSet><note>{"id":"ha-matter-effective-current-20261126","source":"Effective current","canonical":"Strömmens effektivvärde","project":"Home Assistant","component":"Matter electrical sensor","context":"RMS current measurement (key: rms_current)","note":"Använd Strömmens effektivvärde för RMS-mätvärdet av ström; det anger mätvärdets effektiva värde. Källa: Matter-entitetens nyckel rms_current och UI-källtexten Effective current.","scope":"project-context","review_id":"ha-matter-effective-current-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/matter/strings.json\",\"translation_key\":\"rms_current\",\"implementation_context\":\"Matter sensor entity key identifies RMS current.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/matter/strings.json","evidence_sha256":"0f79fbfcbba48e0b2708117097c210efd1b11e11176cfda4269c07042444504b"}</note></termEntry>
<termEntry id="rha-matter-effective-voltage-20261126"><langSet xml:lang="en"><tig><term>Effective voltage</term></tig></langSet><langSet xml:lang="sv"><tig><term>Spänningens effektivvärde</term></tig></langSet><note>{"id":"ha-matter-effective-voltage-20261126","source":"Effective voltage","canonical":"Spänningens effektivvärde","project":"Home Assistant","component":"Matter electrical sensor","context":"RMS voltage measurement (key: rms_voltage)","note":"Använd Spänningens effektivvärde för RMS-mätvärdet av spänning. Källa: Matter-entitetens nyckel rms_voltage och UI-källtexten Effective voltage.","scope":"project-context","review_id":"ha-matter-effective-voltage-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/matter/strings.json\",\"translation_key\":\"rms_voltage\",\"implementation_context\":\"Matter sensor entity key identifies RMS voltage.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/matter/strings.json","evidence_sha256":"c2b16b7d156c88e2116f1b78023aa3ff4cb67dd07b71f1b0b08b7a1c7c8129ad"}</note></termEntry>
<termEntry id="rha-fyta-max_acceptable-threshold-20261126"><langSet xml:lang="en"><tig><term>Maximum acceptable</term></tig></langSet><langSet xml:lang="sv"><tig><term>Övre gräns för acceptabelt värde</term></tig></langSet><note>{"id":"ha-fyta-max_acceptable-threshold-20261126","source":"Maximum acceptable","canonical":"Övre gräns för acceptabelt värde","project":"Home Assistant","component":"Fyta plant sensor threshold","context":"Upper/lower acceptable limit for light, moisture, salinity or temperature","note":"Övre tröskel för värden som är acceptabla för växtens ljus, fukt, salthalt eller temperatur.","scope":"project-context","review_id":"ha-fyta-max_acceptable-threshold-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/fyta/strings.json\",\"translation_key\":\"max_acceptable\",\"implementation_path\":\"homeassistant/components/fyta/sensor.py\",\"implementation_context\":\"The same thresholds are mapped for light, moisture, salinity and temperature measurements.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/fyta/strings.json","evidence_sha256":"884bfd892a34475ef6bba47f432231250b0403d052f0e6eecd7cfc8a8be04291"}</note></termEntry>
<termEntry id="rha-fyta-max_good-threshold-20261126"><langSet xml:lang="en"><tig><term>Maximum good</term></tig></langSet><langSet xml:lang="sv"><tig><term>Övre gräns för bra värde</term></tig></langSet><note>{"id":"ha-fyta-max_good-threshold-20261126","source":"Maximum good","canonical":"Övre gräns för bra värde","project":"Home Assistant","component":"Fyta plant sensor threshold","context":"Upper/lower good limit for light, moisture, salinity or temperature","note":"Övre tröskel för växtens bra värdeintervall.","scope":"project-context","review_id":"ha-fyta-max_good-threshold-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/fyta/strings.json\",\"translation_key\":\"max_good\",\"implementation_path\":\"homeassistant/components/fyta/sensor.py\",\"implementation_context\":\"The same thresholds are mapped for light, moisture, salinity and temperature measurements.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/fyta/strings.json","evidence_sha256":"ea3ba77469e06c37ed06f70bad5037c703bfb0d6296ce6818acb359ef8fd7604"}</note></termEntry>
<termEntry id="rha-fyta-min_acceptable-threshold-20261126"><langSet xml:lang="en"><tig><term>Minimum acceptable</term></tig></langSet><langSet xml:lang="sv"><tig><term>Nedre gräns för acceptabelt värde</term></tig></langSet><note>{"id":"ha-fyta-min_acceptable-threshold-20261126","source":"Minimum acceptable","canonical":"Nedre gräns för acceptabelt värde","project":"Home Assistant","component":"Fyta plant sensor threshold","context":"Upper/lower acceptable limit for light, moisture, salinity or temperature","note":"Nedre tröskel för värden som är acceptabla för växtens ljus, fukt, salthalt eller temperatur.","scope":"project-context","review_id":"ha-fyta-min_acceptable-threshold-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/fyta/strings.json\",\"translation_key\":\"min_acceptable\",\"implementation_path\":\"homeassistant/components/fyta/sensor.py\",\"implementation_context\":\"The same thresholds are mapped for light, moisture, salinity and temperature measurements.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/fyta/strings.json","evidence_sha256":"51bb1b3645fc89e1d00936495770b021d6328db8c7bec1c10e43b00b7fed5a6a"}</note></termEntry>
