<termEntry id="rha-knx-shutter-actuator-20261126"><langSet xml:lang="en"><tig><term>Shutter actuator</term></tig></langSet><langSet xml:lang="sv"><tig><term>jalusiställdon</term></tig></langSet><note>{"id":"ha-knx-shutter-actuator-20261126","source":"Shutter actuator","canonical":"jalusiställdon","project":"Home Assistant","component":"KNX cover configuration","context":"KNX platform description for the cover entity, referring to the actuator controlling a shutter/jalusi.","note":"Use jalusi for the KNX shutter/cover and jalusiställdon for its actuator; avoid the general-purpose lucka or skydd in this control context.","scope":"project-context","review_id":"ha-knx-shutter-actuator-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/knx/strings.json\",\"source_string\":\"The KNX cover platform is used as an interface to shutter actuators.\",\"implementation_context\":\"KNX cover platform controls a shutter actuator.\"}","reference":"https://www.home-assistant.io/integrations/knx","evidence_sha256":"5b8cd72b2fa0a746ddfffc04a92a7d5f12a68fe1a3a7008c55f17504176d7245"}</note></termEntry>
<termEntry id="rha-imeon-smart-load-20261126"><langSet xml:lang="en"><tig><term>Smart load</term></tig></langSet><langSet xml:lang="sv"><tig><term>smartlast</term></tig></langSet><note>{"id":"ha-imeon-smart-load-20261126","source":"Smart load","canonical":"smartlast","project":"Home Assistant","component":"IMEON inverter sensor","context":"Label phrase for information about the inverter smart load feature.","note":"Use smartlast in the IMEON integration context; this is an inverter feature label, not a generic translation for load management.","scope":"project-context","review_id":"ha-imeon-smart-load-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/imeon_inverter/strings.json\",\"translation_key\":\"timeline_type_msg.state.info_smartlo\",\"source_string\":\"Smart load information available.\",\"implementation_context\":\"Timeline message category for smart-load information.\"}","reference":"https://www.home-assistant.io/integrations/imeon_inverter","evidence_sha256":"93a3c6b9a0f16ccce6d2ae3f78e0f69924a3602553f7f0cc445c4c52b46bdb5f"}</note></termEntry>
<termEntry id="rha-knx-dimming-actuator-20261126"><langSet xml:lang="en"><tig><term>Dimming actuator</term></tig></langSet><langSet xml:lang="sv"><tig><term>dimmeraktor</term></tig></langSet><note>{"id":"ha-knx-dimming-actuator-20261126","source":"Dimming actuator","canonical":"dimmeraktor","project":"Home Assistant","component":"KNX light configuration","context":"KNX lighting hardware used by the light platform.","note":"Use the established KNX Swedish term dimmeraktor.","scope":"project-context","review_id":"ha-knx-dimming-actuator-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/knx/strings.json\",\"source_string\":\"The KNX light platform is used as an interface to dimming actuators, LED controllers, DALI gateways and similar.\"}","reference":"https://support.knx.org/hc/sv/articles/23247421441298-Dimmeraktor","evidence_sha256":"5b8cd72b2fa0a746ddfffc04a92a7d5f12a68fe1a3a7008c55f17504176d7245"}</note></termEntry>
<termEntry id="rha-knx-switching-actuator-20261126"><langSet xml:lang="en"><tig><term>Switching actuator</term></tig></langSet><langSet xml:lang="sv"><tig><term>brytaktor</term></tig></langSet><note>{"id":"ha-knx-switching-actuator-20261126","source":"Switching actuator","canonical":"brytaktor","project":"Home Assistant","component":"KNX switch configuration","context":"KNX switch hardware controlling a switching function.","note":"Use KNX Association’s Swedish term brytaktor for the switching actuator.","scope":"project-context","review_id":"ha-knx-switching-actuator-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/knx/strings.json\",\"source_string\":\"The KNX switch platform is used as an interface to switching actuators.\"}","reference":"https://support.knx.org/hc/sv/articles/23248010355986-Brytaktor","evidence_sha256":"5b8cd72b2fa0a746ddfffc04a92a7d5f12a68fe1a3a7008c55f17504176d7245"}</note></termEntry>
<termEntry id="rha-bayesian-20261126"><langSet xml:lang="en"><tig><term>Bayesian</term></tig></langSet><langSet xml:lang="sv"><tig><term>bayesiansk</term></tig></langSet><note>{"id":"ha-bayesian-20261126","source":"Bayesian","canonical":"bayesiansk","project":"Home Assistant","component":"Bayesian sensor","context":"Adjective describing the Bayesian binary sensor and its probability estimate; lowercase in running Swedish text.","note":"Use bayesiansk in the Home Assistant probability-sensor context; capitalize only at sentence start or in title case required by the UI.","scope":"project-context","review_id":"ha-bayesian-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/bayesian/strings.json\",\"source_string\":\"Add a Bayesian sensor\",\"related_context\":\"A virtual binary sensor combines observation probabilities.\"}","reference":"https://www.home-assistant.io/integrations/bayesian/","evidence_sha256":"aedf52e2023d8657a662f3b357a164cd99d95a30f8666d7d8197a8a818d73e7d"}</note></termEntry>
<termEntry id="rha-bayesian-prior-20261126"><langSet xml:lang="en"><tig><term>prior</term></tig></langSet><langSet xml:lang="sv"><tig><term>förhandssannolikhet</term></tig></langSet><note>{"id":"ha-bayesian-prior-20261126","source":"prior","canonical":"förhandssannolikhet","project":"Home Assistant","component":"Bayesian sensor","context":"The baseline probability of the monitored event before observations are considered; Bayesian sensor configuration field.","note":"Använd förhandssannolikhet för prior i Bayesian-konfigurationen. Benämningen gäller sannolikheten innan observationerna vägs in; ordet prior får inte översättas bokstavligt som före.","scope":"project-context","review_id":"ha-bayesian-prior-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"homeassistant/components/bayesian/strings.json\",\"translation_key\":\"component::bayesian::config::step::user::data::prior\",\"source_string\":\"Prior\",\"related_definition\":\"The baseline probability of the event before observations are considered.\",\"documentation\":\"https://www.home-assistant.io/integrations/bayesian/\"}","reference":"https://github.com/yeager/translations/blob/main/Home-Assistant/Lokalise/2026-11-26-reviewed-core-40577-40696.md","evidence_sha256":"eb540c138041106c102c370931e8ae497ca0e0c0f4b724fab933e309126a5843"}</note></termEntry>
<termEntry id="rha-togrill-taste-doneness-20261126"><langSet xml:lang="en"><tig><term>Taste</term></tig></langSet><langSet xml:lang="sv"><tig><term>Stekgrad</term></tig></langSet><note>{"id":"ha-togrill-taste-doneness-20261126","source":"Taste","canonical":"Stekgrad","project":"Home Assistant","component":"ToGrill","context":"Select option with rare, medium rare, medium, medium well and well done values; it selects the desired meat doneness.","note":"Använd Stekgrad i denna selector. Även om integrationens dokumentation kallar fältet taste visar alternativen att det avser hur genomstekt köttet ska bli, inte smak.","scope":"project-context","review_id":"ha-togrill-steak-grade-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_documentation\":\"https://www.home-assistant.io/integrations/togrill\",\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"translation_key\":\"component::togrill::entity::select::taste::name\",\"option_keys\":[\"rare\",\"medium_rare\",\"medium\",\"medium_well\",\"well_done\"],\"supporting_swedish_reference\":\"https://www.mathem.se/se/inspiration/innertemperaturer/\",\"documented_terminology\":\"medium rare is rosa; medium-well is medium välstekt; well done is välstekt\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/togrill/strings.json","evidence_sha256":"66db148ae9d7d50365a4ae1751d9baa2d33ca27d6beeeeecca97eb6f7df66d30"}</note></termEntry>
<termEntry id="rha-togrill-medium-rare-20261126"><langSet xml:lang="en"><tig><term>Medium rare</term></tig></langSet><langSet xml:lang="sv"><tig><term>Rosastekt</term></tig></langSet><note>{"id":"ha-togrill-medium-rare-20261126","source":"Medium rare","canonical":"Rosastekt","project":"Home Assistant","component":"ToGrill","context":"Meat doneness selector option between rare and medium.","note":"Använd Rosastekt; svenska temperaturguider beskriver medium rare som rosa.","scope":"project-context","review_id":"ha-togrill-medium-rare-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"translation_key\":\"component::togrill::entity::select::taste::state::medium_rare\",\"supporting_swedish_reference\":\"https://www.mathem.se/se/inspiration/innertemperaturer/\",\"documented_terminology\":\"Rosa (Medium-rare)\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/togrill/strings.json","evidence_sha256":"66db148ae9d7d50365a4ae1751d9baa2d33ca27d6beeeeecca97eb6f7df66d30"}</note></termEntry>
<termEntry id="rha-togrill-medium-well-20261126"><langSet xml:lang="en"><tig><term>Medium well</term></tig></langSet><langSet xml:lang="sv"><tig><term>Medium välstekt</term></tig></langSet><note>{"id":"ha-togrill-medium-well-20261126","source":"Medium well","canonical":"Medium välstekt","project":"Home Assistant","component":"ToGrill","context":"Meat doneness selector option between medium and well done.","note":"Använd Medium välstekt för denna stekgrad; svenska temperaturguider använder formuleringen.","scope":"project-context","review_id":"ha-togrill-medium-well-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"translation_key\":\"component::togrill::entity::select::taste::state::medium_well\",\"supporting_swedish_reference\":\"https://www.mathem.se/se/inspiration/innertemperaturer/\",\"documented_terminology\":\"medium-well is rendered as medium välstekt\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/togrill/strings.json","evidence_sha256":"66db148ae9d7d50365a4ae1751d9baa2d33ca27d6beeeeecca97eb6f7df66d30"}</note></termEntry>
<termEntry id="rha-vrm-site-20261126"><langSet xml:lang="en"><tig><term>VRM site</term></tig></langSet><langSet xml:lang="sv"><tig><term>VRM-anläggning</term></tig></langSet><note>{"id":"ha-vrm-site-20261126","source":"VRM site","canonical":"VRM-anläggning","project":"Home Assistant","component":"Victron Remote Monitoring","context":"Installation associated with a user account in Victron VRM Portal; the user selects the installation identified by site_id.","note":"Använd VRM-anläggning i användartexter. I VRM avser site den övervakade installationen, inte en webbplats.","scope":"project-context","review_id":"ha-vrm-site-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_paths\":[\"homeassistant/components/victron_remote_monitoring/strings.json\",\"homeassistant/components/victron_remote_monitoring/sensor.py\"],\"translation_keys\":[\"component::victron_remote_monitoring::config::step::select_site::data::site_id\",\"component::victron_remote_monitoring::config::step::select_site::data_description::site_id\"],\"documentation\":\"https://www.victronenergy.com/media/pg/VRM_Portal_manual/sv/getting-started-with-vrm.html\",\"documentation_terminology\":\"Victron Swedish documentation describes the VRM-connected system as an installation/anläggning.\"}","reference":"https://github.com/home-assistant/core/blob/c03d786a2335a70d01860cae56286798bb272871/homeassistant/components/victron_remote_monitoring/strings.json","evidence_sha256":"ead31379107ab654553366a81728b7e315c9685df40ea73c19f387982e5a9d71"}</note></termEntry>
<termEntry id="rha-zigbee-home-automation-name-20261126"><langSet xml:lang="en"><tig><term>Zigbee Home Automation</term></tig></langSet><langSet xml:lang="sv"><tig><term>Zigbee Home Automation</term></tig></langSet><note>{"id":"ha-zigbee-home-automation-name-20261126","source":"Zigbee Home Automation","canonical":"Zigbee Home Automation","project":"Home Assistant","component":"ZHA integration name","context":"Official name of the built-in Home Assistant Zigbee integration, abbreviated ZHA; the integration name appears in a hardware setup selector.","note":"Behåll det officiella integrationsnamnet Zigbee Home Automation på engelska. Använd inte Zigbee Hemautomation; andra HA-källsträngar använder redan det oförändrade officiella namnet.","scope":"project-context","review_id":"ha-zigbee-home-automation-name-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"source_path\":\"sources/home-assistant-core-current/homeassistant/components/homeassistant_hardware/strings.json\",\"translation_key\":\"component::homeassistant_hardware::firmware_picker::options::step::zigbee_integration::menu_options::zigbee_integration_zha\",\"source_string\":\"Zigbee Home Automation\",\"official_integration_name\":\"Zigbee Home Automation (ZHA)\",\"retroactive_alias_key\":\"component::homeassistant_connect_zbt2::config::step::zigbee_integration::menu_options::zigbee_integration_zha\"}","reference":"https://www.home-assistant.io/integrations/zha/","evidence_sha256":"c57694224394645ec87ff4479ee7571416f637b8e2bf54edbad480d6b7596127"}</note></termEntry>
<termEntry id="rvicare-one-time-charge-20261126"><langSet xml:lang="en"><tig><term>One-time charge</term></tig></langSet><langSet xml:lang="sv"><tig><term>engångsuppvärmning av varmvatten</term></tig></langSet><note>{"id":"vicare-one-time-charge-20261126","source":"One-time charge","canonical":"engångsuppvärmning av varmvatten","project":"Home Assistant","component":"ViCare","context":"Knappnamn för en engångsuppvärmning av varmvatten i ViCare.","note":"Använd ”engångsuppvärmning av varmvatten” i stället för ”engångsdebitering”. Home Assistants integrationsdokumentation beskriver knappen som en engångsuppvärmning av varmvattenberedaren.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"Button entities are available to trigger actions like a one-time charge of the water heater.\"}","reference":"https://www.home-assistant.io/integrations/vicare/","evidence_sha256":"3207c60627b7f392e5bd750c5726c7392f9641e6f45e830e8699c45622ea06ea"}</note></termEntry>
<termEntry id="rsmhi-fire-weather-index-20261126"><langSet xml:lang="en"><tig><term>Fire Weather Index</term></tig></langSet><langSet xml:lang="sv"><tig><term>brandriskindex (FWI)</term></tig></langSet><note>{"id":"smhi-fire-weather-index-20261126","source":"Fire Weather Index","canonical":"brandriskindex (FWI)","project":"Home Assistant","component":"SMHI brandrisk","context":"Slutligt FWI-värde för SMHI:s skogsbrandsrisk.","note":"FWI är ett brandriskindex och inte en brandriskprognos. SMHI/MBS beskriver FWI som det slutliga brandriskvärdet.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"Det slutliga brandriskvärdet (FWI) beräknas ur en kombination av ISI och BUI.\"}","reference":"https://www.mcf.se/contentassets/ce53364ca8594e988e3713b91ba846c8/berakningsmetoder-for-brandrisk.pdf","evidence_sha256":"7675c0a459058c5b9ebd50e6f006a74ce7ebf155567d7810911342c942dd255c"}</note></termEntry>
<termEntry id="rsmhi-buildup-index-20261126"><langSet xml:lang="en"><tig><term>Buildup Index</term></tig></langSet><langSet xml:lang="sv"><tig><term>bränsletillgänglighetsindex (BUI)</term></tig></langSet><note>{"id":"smhi-buildup-index-20261126","source":"Buildup Index","canonical":"bränsletillgänglighetsindex (BUI)","project":"Home Assistant","component":"SMHI brandrisk","context":"Underindex i den kanadensiska Fire Weather Index-modellen.","note":"Kontextuell svensk förklaring: BUI beskriver hur stor del av bränslet som är torrt nog att vara tillgängligt för elden.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"BUI (Buildup Index) beräknas som ett viktat medelvärde av DMC och DC och kan ses som ett allmänt fuktighetsmått för de något djupare markskikten.\"}","reference":"https://www.mcf.se/contentassets/ce53364ca8594e988e3713b91ba846c8/berakningsmetoder-for-brandrisk.pdf","evidence_sha256":"e400c4f011fed0f4eca2230cfdbbf00b241f977ea252b95160ad139e38abfead"}</note></termEntry>
<termEntry id="rsmhi-drought-code-20261126"><langSet xml:lang="en"><tig><term>Drought Code</term></tig></langSet><langSet xml:lang="sv"><tig><term>torkindex (DC)</term></tig></langSet><note>{"id":"smhi-drought-code-20261126","source":"Drought Code","canonical":"torkindex (DC)","project":"Home Assistant","component":"SMHI brandrisk","context":"Underindex som beskriver fukthalten i djupare kompakta organiska markskikt.","note":"Kort svensk gränssnittsterm. MSB beskriver DC som fukthalten i tjocka, kompakta humuslager och anger att ett högt värde betyder torka.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"DC (Drought Code) visar fukthalten i tjocka kompakta humuslager; ett lågt värde visar hög fuktighet och ett högt värde visar torka.\"}","reference":"https://www.mcf.se/contentassets/ce53364ca8594e988e3713b91ba846c8/berakningsmetoder-for-brandrisk.pdf","evidence_sha256":"b91bb74d0bc23f26bc7f9647431aa14584045209c5612582042149f81e71585c"}</note></termEntry>
<termEntry id="rsmhi-duff-moisture-code-20261126"><langSet xml:lang="en"><tig><term>Duff Moisture Code</term></tig></langSet><langSet xml:lang="sv"><tig><term>fuktkod för humuslager (DMC)</term></tig></langSet><note>{"id":"smhi-duff-moisture-code-20261126","source":"Duff Moisture Code","canonical":"fuktkod för humuslager (DMC)","project":"Home Assistant","component":"SMHI brandrisk","context":"Underindex för fuktighet i ett något djupare organiskt markskikt.","note":"MSB beskriver DMC som fuktigheten i ett något djupare skikt av bränslet på marken, exempelvis mosskiktet och övre delen av humuslagret. Termen är en kort kontextuell etikett.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"DMC representerar fuktigheten i ett något djupare skikt av bränslet på marken (ca 7 cm), exempelvis mosskiktet och övre delen av humuslagret.\"}","reference":"https://www.mcf.se/contentassets/7d6c5dbbcb3e443b9cd16b0e0a3ef10b/vagledning-skogsbrandslackning-2022.pdf","evidence_sha256":"20547f1560d77cf51fd80fcc7180e50a8ff77401078ef149e3c54b7594424a7e"}</note></termEntry>
<termEntry id="rsmhi-fine-fuel-moisture-code-20261126"><langSet xml:lang="en"><tig><term>Fine Fuel Moisture Code</term></tig></langSet><langSet xml:lang="sv"><tig><term>finbränslets fuktkod (FFMC)</term></tig></langSet><note>{"id":"smhi-fine-fuel-moisture-code-20261126","source":"Fine Fuel Moisture Code","canonical":"finbränslets fuktkod (FFMC)","project":"Home Assistant","component":"SMHI brandrisk","context":"Underindex för fuktighet/uttorkning i vegetationens ytligaste bränsleskikt.","note":"Kort svensk gränssnittsterm. SMHI anger att FFMC beskriver uttorkningen i det ytligaste markskiktet; MSB beskriver bland annat blad och gräs.","scope":"project-context","review_id":"ha-core-review-20261126","publication_status":"reviewed-local-amendment","source_evidence":"{\"home_assistant_core_revision\":\"c03d786a2335a70d01860cae56286798bb272871\",\"authoritative_excerpt\":\"FFMC beskriver uttorkningen i det ytligaste markskiktet\"}","reference":"https://www.smhi.se/brandrisk-skog-och-mark","evidence_sha256":"834ce65e1478d988fdf0e6a8c261dfcdb85eb9c1dc68c43e509b1c6fc9b7892d"}</note></termEntry>
</body></text></martif>
